#!/usr/bin/env bash
# Auto-rotate internal display based on IIO accelerometer orientation.
# Requires: iio-sensor-proxy (monitor-sensor), hyprctl, jq, wvkbd-mobintl
#
# `screen-rotation tablet-mode on|off` shows/hides the OSK; it is called by
# the Hyprland tablet-mode switch bindings in ~/.config/hypr/bindings.lua.

MONITOR="eDP-1"
RES="1920x1200@60"
POS="0x360"
SCALE="1.666667"
TABLET_STATE_FILE="/tmp/screen-rotation-tablet-mode"

osk() {
    if [[ "$1" == "true" ]]; then
        pkill -USR2 wvkbd-mobintl 2>/dev/null || true  # show
    else
        pkill -USR1 wvkbd-mobintl 2>/dev/null || true  # hide
    fi
}

start_wvkbd() {
    pkill -x wvkbd-mobintl 2>/dev/null || true
    sleep 0.3
    wvkbd-mobintl --hidden -L 300 &
    sleep 0.3
    # Restore OSK if currently in tablet mode
    if [[ "$(cat "$TABLET_STATE_FILE" 2>/dev/null)" == "1" ]]; then
        osk true
    fi
}

rotate() {
    local transform
    case "$1" in
        normal)     transform=0 ;;
        left-up)    transform=1 ;;
        bottom-up)  transform=2 ;;
        right-up)   transform=3 ;;
        *)          return ;;
    esac
    echo "Rotating to transform $transform ($1)"
    # Lua config: `hyprctl keyword` is rejected, apply changes via `hyprctl eval`
    hyprctl eval "hl.monitor({ output = \"$MONITOR\", mode = \"$RES\", position = \"$POS\", scale = $SCALE, transform = $transform })"
    # Rotate every touchscreen and pen along with the display
    local device
    hyprctl devices -j | jq -r '.touch[].name, (.tablets[] | select(.name) | .name)' |
        while IFS= read -r device; do
            hyprctl eval "hl.device({ name = \"$device\", output = \"$MONITOR\", transform = $transform })"
        done
    start_wvkbd
}

if [[ "$1" == "tablet-mode" ]]; then
    if [[ "$2" == "on" ]]; then
        echo "1" > "$TABLET_STATE_FILE"
        osk true
    else
        echo "0" > "$TABLET_STATE_FILE"
        osk false
    fi
    exit 0
fi

start_wvkbd

# Restart monitor-sensor if it exits (e.g. "Failed to claim accelerometer").
while true; do
    monitor-sensor 2>&1 | while IFS= read -r line; do
        echo "sensor: $line"
        if [[ "$line" == *"orientation changed: "* ]]; then
            orientation="${line##*orientation changed: }"
            orientation="${orientation//[[:space:]]/}"
            rotate "$orientation"
        fi
    done
    echo "monitor-sensor exited, restarting in 2s"
    sleep 2
done
